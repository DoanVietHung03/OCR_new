# Server-only values. Never expose this file's values to browser code.
OCR_DATA_DIR=./data/jobs
OCR_PROVIDER=minimax
OCR_BASE_URL=http://provider.example/v1
OCR_API_KEY=replace-me
OCR_MODEL=replace-me
THINKING_MODE=false
OCR_STRUCTURED_OUTPUT=false
OCR_MAX_TOKENS_METADATA=2048
OCR_MAX_TOKENS_FULL_OCR=8192
OCR_MAX_TOKENS_SEGMENTATION=64
OCR_ENDPOINT_EXTERNAL=true
OCR_TIMEOUT_SECONDS=180
# Ollama host settings. The external Ollama service must load these itself.
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
CELERY_BROKER_URL=redis://redis:6380/0
CELERY_RESULT_BACKEND=redis://redis:6380/1
OCR_AUTH_MODE=shared
OCR_PUBLIC_ORIGIN=http://10.6.18.76:54846
OCR_AUTH_USERNAME=ocr
OCR_AUTH_PASSWORD_HASH=scrypt:16384,8,1:replace-salt:replace-digest
OCR_AUTH_SESSION_SECRET=replace-with-64-hex-characters
