            "title": "Vlm Task",
            "default": "full_ocr"
          },
          "vlm_pages": {
            "type": "string",
            "title": "Vlm Pages",
            "default": "all"
          },
          "vlm_max_pages": {
            "type": "integer",
            "title": "Vlm Max Pages",
            "default": 0
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version",
            "default": "3"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "file_count"
        ],
        "title": "CreateJobRequest"
      },
      "HTTPValidationError": {
        "properties": {
